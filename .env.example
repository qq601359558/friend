# 大模型配置（支持通义千问、DeepSeek、SiliconFlow 等任何 OpenAI 兼容接口）
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 多模态视觉模型配置（用于“双向看见你”前置摄像头画面理解）
VLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3

# 语音合成引擎配置:
# TTS_PROVIDER 可选: edge (默认免费高稳定) 或 siliconflow (云端 CosyVoice2 拟真/克隆音色)
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+5%
COSYVOICE_MODEL=FunAudioLLM/CosyVoice2-0.5B
COSYVOICE_VOICE=FunAudioLLM/CosyVoice2-0.5B:claire
# 可选：放入 5~10 秒参考音频路径即可开启零样本专属女友声音克隆
REFERENCE_AUDIO_PATH=assets/reference_voice.wav
REFERENCE_AUDIO_TEXT=

# 伴侣人设与主动关怀
AI_NAME=星晚
USER_NAME=你
PROACTIVE_IDLE_SECONDS=75

# 运行模式: mock (笔记本轻量调试) 或 liveportrait (5060 Ti GPU硬件驱动)
AVATAR_MODE=mock
HOST=0.0.0.0
PORT=8899

# 局域网手机/平板 HTTPS 连麦证书（运行 python scripts/generate_cert.py 自动生成）
SSL_CERTFILE=
SSL_KEYFILE=
